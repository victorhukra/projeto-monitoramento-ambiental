# Copie para .env e preencha. Sem esses valores, a interface informa que o banco não está configurado.
# Valores em: painel do Supabase → Project Settings → API Keys.

# URL do projeto, ex.: https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Chave PÚBLICA: "anon public" (eyJ...) ou "Publishable key" (sb_publishable_...).
# NUNCA use a service_role nem a Secret key (sb_secret_...).
VITE_SUPABASE_ANON_KEY=

# URL base da API do backend (Flask), sem barra no final, ex.: http://localhost:5000
# Fica visível no navegador: não coloque senha nem chave secreta aqui.
# NUNCA copie SUPABASE_SERVICE_ROLE_KEY (sb_secret_...) para este arquivo: ela é só do backend.
VITE_API_URL=
